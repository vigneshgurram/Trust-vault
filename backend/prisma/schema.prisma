generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         String   @default("viewer") // admin, owner, viewer
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  documents          Document[]
  permissionsGranted DocumentPermission[] @relation("GrantedBy")
  permissionsReceived DocumentPermission[] @relation("GrantedTo")
  auditLogs          AuditLog[]

  @@map("users")
}

model Document {
  id               String    @id @default(uuid())
  title            String
  description      String?
  category         String?
  filePath         String    @map("file_path")
  originalFilename String    @map("original_filename")
  fileSize         Int       @map("file_size")
  mimeType         String    @map("mime_type")
  checksum         String
  encryptionIv     String    @map("encryption_iv")
  ownerId          String    @map("owner_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  owner       User                 @relation(fields: [ownerId], references: [id])
  permissions DocumentPermission[]

  @@map("documents")
}

model DocumentPermission {
  id              String    @id @default(uuid())
  documentId      String    @map("document_id")
  userId          String    @map("user_id")
  permissionLevel String    @map("permission_level") // READ, EDIT
  grantedById     String    @map("granted_by_id")
  grantedAt       DateTime  @default(now()) @map("granted_at")
  revokedAt       DateTime? @map("revoked_at")

  document  Document @relation(fields: [documentId], references: [id])
  user      User     @relation("GrantedTo", fields: [userId], references: [id])
  grantedBy User     @relation("GrantedBy", fields: [grantedById], references: [id])

  @@unique([documentId, userId, permissionLevel, revokedAt])
  @@map("document_permissions")
}

model AuditLog {
  sequenceNumber Int      @id @default(autoincrement()) @map("sequence_number")
  id             String   @unique @default(uuid())
  timestamp      DateTime @default(now())
  userId         String?  @map("user_id")
  action         String   // UPLOAD, DOWNLOAD, VIEW, EDIT, DELETE, PERMISSION_GRANT, PERMISSION_REVOKE, LOGIN, LOGIN_FAILED, LOGOUT, USER_CREATED, USER_UPDATED, CHAIN_VERIFIED
  resourceType   String?  @map("resource_type") // document, user, permission
  resourceId     String?  @map("resource_id")
  details        String?  // JSON string
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  previousHash   String?  @map("previous_hash")
  entryHash      String   @map("entry_hash")

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
