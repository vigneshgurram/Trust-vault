{
  "name": "trustvault-backend",
  "version": "1.0.0",
  "description": "TrustVault - Secure Document Sharing Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
